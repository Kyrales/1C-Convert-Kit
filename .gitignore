# Python
__pycache__/
*.py[cod]
*.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Проекты пользователя (содержимое, но не структура)
projects/*/
!projects/README.md
!projects/.gitignore
!projects/base_1.env.template

# Временные файлы
temp/*
!temp/.gitkeep

# Логи
logs/*
!logs/.gitkeep
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# 1C специфичные
*.1CD
*.1CL
*.lgf
*.lgp
*.lock

# Тестовые данные
tests/fixtures/bin/*
tests/fixtures/output/*
!tests/fixtures/output/.gitkeep
